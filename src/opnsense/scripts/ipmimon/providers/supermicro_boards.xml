        <match source="smbios.planar.product" pattern="MBD-X10SDV-8C-TLN4F" />
        <fan-modes>
            <mode id="standard" code="00" name="Standard" />
            <mode id="full" code="01" name="Full Speed" />
            <mode id="optimal" code="02" name="Optimal" />
        </fan-modes>
        <sensors>
            <sensor pattern="CPU Temp" />
            <sensor pattern="System Temp" />
            <sensor pattern="Peripheral Temp" />
            <sensor pattern="PCH Temp" />
            <sensor pattern="Memory Temp" />
            <sensor pattern="DIMM*" />
            <sensor pattern="FAN1" />
            <sensor pattern="FAN2" />
            <sensor pattern="FAN3" />
            <sensor pattern="FAN4" />
            <sensor pattern="FANA" />
        </sensors>
        <groups>
            <group id="group_fan0" name="GRP_FAN0" category="Fans" unit="RPM" method="mean">
                <member pattern="FAN1" />
                <member pattern="FAN2" />
                <member pattern="FAN3" />
            </group>
            <group id="group_fan1" name="GRP_FAN1" category="Fans" unit="RPM" method="mean">
                <member pattern="FANA" />
            </group>
        </groups>
    </board>
    <!-- More embedded Xeon D boards. Only live SDR readings become initial choices.
         X10 HeavyIO is limited to documented dual-zone designs (Supermicro FAQ 16758).
