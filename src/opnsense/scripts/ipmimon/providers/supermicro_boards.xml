    <board id="supermicro-a2sdi-8cplus-hln4f">
        <match source="fru.board.product" pattern="A2SDi-8C+-HLN4F" />
        <match source="fru.board.product" pattern="MBD-A2SDi-8C+-HLN4F" />
        <match source="fru.product.name" pattern="A2SDi-8C+-HLN4F" />
        <match source="smbios.planar.product" pattern="A2SDi-8C+-HLN4F" />
        <match source="smbios.planar.product" pattern="MBD-A2SDi-8C+-HLN4F" />
        <fan-modes>
            <mode id="standard" code="00" name="Standard" />
            <mode id="full" code="01" name="Full Speed" />
            <mode id="optimal" code="02" name="Optimal" />
        </fan-modes>
        <sensors>
            <sensor pattern="CPU Temp" />
            <sensor pattern="System Temp" />
            <sensor pattern="Peripheral Temp" />
            <sensor pattern="DIMM*" />
            <sensor pattern="FAN1" />
            <sensor pattern="FAN2" />
            <sensor pattern="FAN3" />
