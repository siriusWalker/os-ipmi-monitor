    <!-- A2SDi TP8F variants: four DIMM slots and four fan headers; no assumed fan-zone wiring. -->
    <!-- TESTED: A2SDi-TP8F; IPMI reads and fan-mode writes on the OPNsense test firewall. -->
    <board id="supermicro-a2sdi-tp8f">
        <match source="fru.board.product" pattern="A2SDi-TP8F" />
        <match source="fru.product.name" pattern="A2SDi-TP8F" />
        <match source="bmc.product_name" pattern="A2SDi-TP8F" />
        <match source="smbios.planar.product" pattern="A2SDi-TP8F" />
        <fan-modes>
            <mode id="standard" code="00" name="Standard" />
            <mode id="full" code="01" name="Full Speed" />
            <mode id="optimal" code="02" name="Optimal" />
            <mode id="pue2" code="03" name="PUE2" />
            <mode id="heavyio" code="04" name="HeavyIO" />
        </fan-modes>
        <sensors>
            <sensor pattern="CPU Temp" />
            <sensor pattern="System Temp" />
            <sensor pattern="Peripheral Temp" />
            <sensor pattern="MB_10G Temp" />
            <sensor pattern="FAN*" />
            <sensor pattern="DIMM*" />
            <sensor pattern="Fan Mode" />
            <sensor pattern="PWM zone *" />
        </sensors>
        <groups>
            <group id="group_fan0" name="GRP_FAN0" category="Fans" unit="RPM" method="mean">
                <member pattern="FAN1" />
                <member pattern="FAN2" />
            </group>
            <group id="group_fan1" name="GRP_FAN1" category="Fans" unit="RPM" method="mean">
                <member pattern="FANA" />
            </group>
            <group id="group_memory" name="GRP_MEMORY" category="Temperatures" unit="°C" method="mean">
                <member pattern="DIMM*" />
            </group>
        </groups>
    </board>
    <!-- X10SDV Mini-ITX: MNL-1726, p. 2-20. PCB 2.00 uses FAN4 as zone 2,
