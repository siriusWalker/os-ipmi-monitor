<?xml version="1.0" encoding="UTF-8"?>
<board-profiles>
    <!-- Match any listed FRU/BMC identity. Patterns are case insensitive; * is allowed only at the end. -->
    <!-- These suggestions never restrict the live SDR sensor enumeration. -->
    <!-- Supermicro documents IPMICFG mode numbers 0/1/2 (FAQ 35599), but does not
         confirm the OEM raw command on every board here. Lists vary by system
         (Super BMC IPMI User's Guide, section 2-7-15). The raw command has been
         physically validated only on A2SDi-TP8F. -->
    <!-- A2SDi HLN4F variants: four DIMM slots and four fan headers; no assumed fan-zone wiring. -->
    <!-- UNTESTED: A2SDi-4C-HLN4F; profile based on manufacturer documentation. -->
    <board id="supermicro-a2sdi-4c-hln4f">
        <match source="fru.board.product" pattern="A2SDi-4C-HLN4F" />
        <match source="fru.board.product" pattern="MBD-A2SDi-4C-HLN4F" />
        <match source="fru.product.name" pattern="A2SDi-4C-HLN4F" />
        <match source="smbios.planar.product" pattern="A2SDi-4C-HLN4F" />
        <match source="smbios.planar.product" pattern="MBD-A2SDi-4C-HLN4F" />
        <fan-modes>
            <mode id="standard" code="00" name="Standard" />
            <mode id="full" code="01" name="Full Speed" />
            <mode id="optimal" code="02" name="Optimal" />
        </fan-modes>
        <sensors>
            <sensor pattern="CPU Temp" />
            <sensor pattern="System Temp" />
            <sensor pattern="Peripheral Temp" />
            <sensor pattern="DIMM*" />
            <sensor pattern="FAN1" />
            <sensor pattern="FAN2" />
            <sensor pattern="FAN3" />
            <sensor pattern="FANA" />
        </sensors>
        <groups>
            <group id="group_memory" name="GRP_MEMORY" category="Temperatures" unit="°C" method="mean">
                <member pattern="DIMM*" />
            </group>
        </groups>
    </board>
